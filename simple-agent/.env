# 复制本文件为 .env，并填入你自己的 API Key
# cp .env.example .env

# === 默认：DeepSeek（国内可直连）===
LLM_API_KEY=sk-4e7599d393b94868b7135d4c1f0fb887
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# === 切换到 OpenAI 示例（需要代理）===
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# === 短期记忆 ===
SHORT_TERM_TURNS=10

# === 会话持久化（SQLite）===
ENABLE_SESSION_STORE=0
SESSION_ID=default
SESSION_DB_PATH=sessions.db
SESSION_LOAD_LIMIT=40

# === 长期向量记忆（需 pip install chromadb）===
ENABLE_LONG_TERM=0
LONG_TERM_DB_PATH=./chroma_store

# Embedding：provider=openai(默认) / hash(无网络demo)
EMBED_PROVIDER=openai
# EMBED_API_KEY=sk-xxx               # 不填则复用 LLM_API_KEY
# EMBED_BASE_URL=https://api.openai.com/v1  # 不填则复用 LLM_BASE_URL
EMBED_MODEL=text-embedding-3-small